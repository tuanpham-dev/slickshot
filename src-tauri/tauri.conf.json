{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlickShot",
  "version": "1.0.0",
  "identifier": "dev.tuanp.slickshot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlickShot",
        "url": "index.html",
        "width": 480,
        "height": 640,
        "resizable": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#16181d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' slickshot: http://slickshot.localhost data:; connect-src 'self' slickshot: http://slickshot.localhost ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "tesseract-ocr",
          "tesseract-ocr-eng"
        ],
        "recommends": [
          "fonts-noto-color-emoji"
        ]
      },
      "rpm": {
        "depends": [
          "tesseract",
          "tesseract-langpack-eng"
        ],
        "recommends": [
          "google-noto-emoji-color-fonts"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlERkMwMzhDMzU4MjQxOQpSV1FaSkZqRE9NRGZDU1o0NnIxZmpmUVA2SHN2WksyS1JaL1ZaSkE2SXZWT0d6Tk5UT3AwNDdQWgo=",
      "endpoints": [
        "https://github.com/tuanpham-dev/slickshot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
