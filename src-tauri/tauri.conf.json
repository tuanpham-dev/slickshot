{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlickShot",
  "version": "0.1.0",
  "identifier": "dev.tuanp.slickshot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlickShot",
        "url": "index.html",
        "width": 480,
        "height": 640,
        "resizable": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#16181d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' slickshot: http://slickshot.localhost data:; connect-src 'self' slickshot: http://slickshot.localhost ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["tesseract-ocr", "tesseract-ocr-eng"]
      },
      "rpm": {
        "depends": ["tesseract", "tesseract-langpack-eng"]
      }
    }
  }
}
